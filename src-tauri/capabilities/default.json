{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "AstraLink main window UI and file picker",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    "dialog:allow-save",
    {
      "identifier": "opener:allow-open-url",
      "allow": [{ "url": "https://github.com/xinglinglove1029/astralink/releases/latest" }]
    }
  ]
}
